# JavaMind AI — Environment Variables
# Copy this file to .env and fill in your values

# ── Electron Main Process (Electron only) ─────────────────────────────

# Anthropic API Key (required for AI features)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (optional)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=

# ── Web / Renderer (Electron + Web) ──────────────────────────────────

# Anthropic API Key (for web version)
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Gemini API Key (for web version)
VITE_GEMINI_API_KEY=

# OpenAI API Key (for web version)
VITE_OPENAI_API_KEY=

# Ollama server URL (for web version)
# Default: https://ollama-java-424719194394.europe-west1.run.app
VITE_OLLAMA_URL=

# Supabase (optional — enables cloud sync and user accounts)
# Get these from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin emails (comma-separated)
# Users with these emails get access to the Admin panel
VITE_ADMIN_EMAILS=admin@example.com

# Development mode flag (set automatically by npm scripts)
# ELECTRON_DEV=true
# VITE_DEV=true
